[Unit]
Description=Rig heater-safety watchdog (ticket 0034) — cuts Shelly ch0 when no live run wants heat
Documentation=https://github.com/opprud/TestRigInstrumentation/blob/AutoDetectScope_moj/TEAM/tickets/0034-vps-heater-safety-watchdog.md
After=network-online.target mosquitto.service
Wants=network-online.target
# Safety daemon: never give up restarting it (disable the start-rate limit).
StartLimitIntervalSec=0

[Service]
Type=simple
User=claude-win
WorkingDirectory=/home/claude-win/heater-watchdog
Environment=PYTHONPATH=/home/claude-win/heater-watchdog/vendor
ExecStart=/usr/bin/python3 /home/claude-win/heater-watchdog/watchdog.py --config /home/claude-win/heater-watchdog/config.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
