# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
env/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (HDF5, CSV, etc.)
# Ignore all files in data directories
py/data/*
data/*

# But keep the .gitkeep files to preserve directory structure
!py/data/.gitkeep
!data/.gitkeep

# Log files
*.log
py/*.log
visa_io.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# React/Node
node_modules/
react/node_modules/
react/dist/
react/build/
*.local

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Agent-bus watchdog local state (ticket 0009); the log is covered by *.log above
.bus_watchdog_state.json
py/.bus_watchdog_state.json

# Auto-generated inline test profiles written by the dashboard at run time
react/public/config/inline_*.json

# BearingBrain OE BLE sensor test — sampler output is data, not source.
# Keep the directory itself so run_sampler.py has somewhere to write.
BearingBrain/PiSensorTest/samples/*
!BearingBrain/PiSensorTest/samples/.gitkeep
BearingBrain/PiSensorTest/*.html
*_connection.json
azure_connection.json
**/*_connection.json
.bus_poll_state.json
py/.bus_poll_state.json
