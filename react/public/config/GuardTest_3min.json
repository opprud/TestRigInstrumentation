{
  "name": "Guard acceptance 3 min",
  "description": "Short profile for ticket 0008 acceptance: verify the heater guard auto-arms and survives the run being killed. rpm 0 throughout and no temperature schedule, so the run needs neither the VFD nor the Omron \u2014 it tests the guard, not the rig.",
  "duration_minutes": 3,
  "control": {
    "rpm_per_hz_guess": 59.5,
    "open_loop": true
  },
  "setpoints": {
    "rpm": [
      {
        "time_sec": 0,
        "value": 0
      },
      {
        "time_sec": 180,
        "value": 0
      }
    ]
  },
  "acquisition": {
    "scope_points": "MAX",
    "acq_points": 1000000,
    "samples_per_step": 3,
    "interval_sec": 12,
    "waveform_format": "WORD",
    "acq_type": "NORM"
  },
  "scope_channels": {
    "UL": {
      "timebase_range": 0.2,
      "volt_range": 16.0,
      "volt_offset": 0.0,
      "coupling": "DC"
    },
    "AE": {
      "timebase_range": 0.2,
      "volt_range": 4.0,
      "volt_offset": 0.0,
      "coupling": "DC"
    },
    "SP": {
      "timebase_range": 0.2,
      "volt_range": 8.0,
      "volt_offset": 0.0,
      "coupling": "DC"
    }
  }
}
