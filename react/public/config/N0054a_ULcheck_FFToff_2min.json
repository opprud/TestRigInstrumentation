        "time_sec": 0,
        "value": 0
      },
      {
        "time_sec": 29,
        "value": 0
      },
      {
        "time_sec": 30,
        "value": 1800
      },
      {
        "time_sec": 89,
        "value": 1800
      },
      {
        "time_sec": 90,
        "value": 0
      },
      {
        "time_sec": 119,
        "value": 0
      }
    ]
  },
  "acquisition": {
    "scope_points": "MAX",
    "acq_points": 1000000,
    "samples_per_step": 3,
    "interval_sec": 12,
    "waveform_format": "WORD",
    "acq_type": "NORM"
  },
  "scope_channels": {
    "UL": {
      "timebase_range": 0.2,
      "volt_range": 12.0,
      "volt_offset": 0.0,
      "coupling": "DC"
